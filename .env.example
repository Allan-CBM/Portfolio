# Public URL of the site, used for canonical links, Open Graph, the sitemap and JSON-LD.
# Optional on Vercel: the production domain is detected automatically when it is not set.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional, currently unused: contact email shown on the site.
# Leave empty to keep the email link hidden (LinkedIn is the contact channel).
NEXT_PUBLIC_CONTACT_EMAIL=""
