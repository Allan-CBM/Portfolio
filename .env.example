# ─────────────────────────────────────────────────────────────
# Sanity
# Create a project at https://www.sanity.io/manage (or run `npx sanity init --env`)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-02-19"
NEXT_PUBLIC_SANITY_STUDIO_URL="/studio"

# Viewer token (Sanity Manage → API → Tokens → Add API token → "Viewer").
# Required for Live Preview, Draft Mode and the Live Content API. Never expose it with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=""

# Shared secret for the optional Sanity webhook → /api/revalidate
SANITY_REVALIDATE_SECRET=""

# Used by the Sanity CLI (sanity deploy / dataset import)
SANITY_STUDIO_PROJECT_ID="your-project-id"
SANITY_STUDIO_DATASET="production"
# Only for a hosted studio (npm run studio:deploy): the site URL loaded in Live Preview
SANITY_STUDIO_PREVIEW_ORIGIN=""

# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Fallback contact email if none is set in Sanity → Site Settings
NEXT_PUBLIC_CONTACT_EMAIL=""
